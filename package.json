{
  "name": "yurumirror",
  "version": "1.0.0",
  "description": "YuruMirror build script",
  "scripts": {
    "lint": "eslint src/assets/js/*.js",
    "lint:fix": "eslint src/assets/js/*.js --fix",
    "build-css": "npx -y @tailwindcss/cli -i src/assets/css/input.css -o src/assets/css/tailwind.css --watch",
    "build-css-prod": "npx -y @tailwindcss/cli -i src/assets/css/input.css -o src/assets/css/tailwind.css --minify"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "eslint": "^8.57.0"
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "es6": true
    },
    "extends": "eslint:recommended",
    "globals": {
      "baguetteBox": "readonly",
      "vanillaZoom": "readonly"
    },
    "rules": {
      "indent": [
        "error",
        2
      ],
      "quotes": [
        "error",
        "single"
      ],
      "semi": [
        "error",
        "always"
      ],
      "no-unused-vars": [
        "warn",
        {
          "args": "none"
        }
      ],
      "no-console": "off"
    }
  }
}
