{
  "name": "mirror-project",
  "version": "1.0.0",
  "description": "Mirror project with JavaScript file management",
  "scripts": {
    "lint": "eslint src/assets/js/*.js",
    "lint:fix": "eslint src/assets/js/*.js --fix"
  },
  "devDependencies": {
    "eslint": "^8.57.0"
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "es6": true
    },
    "extends": "eslint:recommended",
    "globals": {
      "baguetteBox": "readonly",
      "vanillaZoom": "readonly"
    },
    "rules": {
      "indent": ["error", 2],
      "quotes": ["error", "single"],
      "semi": ["error", "always"],
      "no-unused-vars": ["warn", { "args": "none" }],
      "no-console": "off"
    }
  }
} 